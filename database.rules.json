{
  "rules": {
    "instructors": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && (root.child('admins').child(auth.uid).val() === true || root.child('registrationRequests').child($uid).child('status').val() === 'approved')",
        ".write": "auth != null && auth.uid === $uid && (root.child('admins').child(auth.uid).val() === true || root.child('registrationRequests').child($uid).child('status').val() === 'approved')"
      }
    },
    "accounts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && (root.child('admins').child(auth.uid).val() === true || root.child('registrationRequests').child($uid).child('status').val() === 'approved')",
        ".write": "auth != null && auth.uid === $uid && (root.child('admins').child(auth.uid).val() === true || root.child('registrationRequests').child($uid).child('status').val() === 'approved')"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "registrationRequests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.child('status').val() === 'pending'))",
        ".validate": "newData.hasChildren(['uid', 'name', 'email', 'status', 'created_at']) && newData.child('uid').val() === $uid && (newData.child('status').val() === 'pending' || newData.child('status').val() === 'approved' || newData.child('status').val() === 'rejected') && (!newData.hasChild('active') || newData.child('active').isBoolean())"
      }
    },
    "accessKeys": {
      "$key": {
        ".read": false,
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('registrationRequests').child(auth.uid).child('status').val() === 'approved' && (newData.child('uid').val() === auth.uid || data.child('uid').val() === auth.uid)))"
      }
    }
  }
}
